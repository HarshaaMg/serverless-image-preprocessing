# .gitignore lists files and folders Git must NOT track or commit.
# Each rule is a pattern: "name/" matches a folder anywhere, "*.ext" matches any file
# with that extension, and a leading "!" re-includes something an earlier rule excluded.
# Ignored files still exist on your computer; they just never go to GitHub.

# Secrets and local environment files
# .env files hold machine-specific settings. In this project frontend/.env.aws.local
# (written by scripts/configure_frontend.ps1) contains the deployed API URL.
.env
.env.*
# ...but the template frontend/.env.example (no real values) IS committed.
!.env.example
# Private keys / certificates, and AWS credential files, must never be committed.
*.pem
*.key
credentials
.aws/

# Python
# __pycache__ and *.pyc/*.pyo/*.pyd are compiled bytecode Python creates automatically.
__pycache__/
*.py[cod]
# Virtual environments (backend/.venv) contain installed packages; anyone can recreate
# them with "pip install -r backend/requirements-dev.txt".
.venv/
venv/
# Generated by pytest and coverage tools while running tests.
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
# build/ holds the Lambda package folders and zips made by scripts/build_lambda.ps1
# (rebuilt on demand, and the processor zip contains the Linux Pillow binaries).
build/
dist/
*.zip

# Node
# node_modules is restored with "npm install" from package-lock.json.
node_modules/
# Output of "npm run build" (production bundle), regenerated on demand.
frontend/dist/

# Terraform: state files contain resource details and must never be committed
# .terraform/ = provider plugins downloaded by "terraform init" (large, re-downloadable).
.terraform/
# terraform.tfstate, terraform.tfstate.backup and the manual copies in
# infra/state-backups/ (named terraform.tfstate.backup-...) all match these two patterns.
*.tfstate
*.tfstate.*
# terraform.tfvars holds personal values (e.g. the SNS notification email address)...
*.tfvars
# ...while example files with placeholder values are committed.
!*.tfvars.example
# Crash logs Terraform writes if it fails unexpectedly.
crash.log
crash.*.log
# Saved plan files (infra/tfplan) can contain sensitive values and are throwaway.
*.tfplan
tfplan
# Local override files are personal, temporary changes to the configuration.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# NOTE: infra/.terraform.lock.hcl is intentionally NOT ignored: it pins the exact
# provider versions so everyone gets the same ones.

# Local demo / test output
# Test images generated by frontend/e2e/make_fixtures.py before browser tests.
frontend/e2e/.fixtures/
# Playwright results, traces and HTML reports from browser test runs.
frontend/test-results/
frontend/playwright-report/
# Reserved for local demo data (the current dev server keeps everything in memory).
backend/local/.data/

# Editor / OS
# Personal editor settings (VS Code, JetBrains) and operating-system junk files.
.vscode/
.idea/
Thumbs.db
.DS_Store
